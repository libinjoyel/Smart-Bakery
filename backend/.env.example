# Port (auto-assigned by Render in production, defaults to 5000 locally)
PORT=5000

# Neon PostgreSQL connection string (Use the pooled connection string from Neon Console)
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Authentication & Credentials (placeholders - do not put real passwords here)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
STAFF_USERNAME=staff
STAFF_PASSWORD=your_staff_password_here
JWT_SECRET=your_jwt_secret_here
